# ==========================================================================
# TEMPLATE .env UNTUK DEPLOY DI ARENHOST / SHARED HOSTING CPANEL
# --------------------------------------------------------------------------
# PETUNJUK:
#   1. Upload project Laravel ke:    /home/USERNAME_CPANNEL/agus-meubel
#   2. Pindahkan ISI public/ ke:    /home/USERNAME_CPANNEL/public_html
#   3. Copy file ini -> rename jadi .env di FOLDER PROJECT LARAVEL:
#                                   /home/USERNAME_CPANNEL/agus-meubel/.env
#   4. Ganti SEMUA baris yang ditandai 👉 (WAJIB DIISI) sesuai akun kamu
#   5. Jalankan:  cd /home/USERNAME_CPANNEL/agus-meubel
#                 php artisan key:generate
#                 php artisan migrate --force
#                 php artisan deploy:shared-hosting
# ==========================================================================

# ==========================================================================
# 🔴 1. SETUP APLIKASI UTAMA (WAJIB DIISI SEMUA)
# ==========================================================================
APP_NAME="Agus Mebel Jepara"
APP_ENV=production
APP_KEY=                                         # 👉 JANGAN DIISI MANUAL! Jalankan: php artisan key:generate
APP_DEBUG=false                                  # 👉 HARUS false di PRODUKSI (tidak boleh tampilkan error ke user)
APP_URL=https://namadomainkamu.com               # 👉 GANTI dengan domain kamu (https:// dulu)

# ==========================================================================
# 🔴 2. PATH UTAMA SHARED HOSTING (WAJIB DIISI! INI YANG PENTING BANGET)
# --------------------------------------------------------------------------
# Ganti USERNAME_CPANNEL dengan username cPanel ArenHost kamu.
# Biasanya kelihatan di pojok kanan atas cPanel atau di info akun.
# Contoh username: agusgero -> path jadi /home/agusgero/public_html
# ==========================================================================
APP_PUBLIC_PATH=/home/USERNAME_CPANNEL/public_html
PUBLIC_STORAGE_PATH=/home/USERNAME_CPANNEL/public_html/storage

# ==========================================================================
# 3. LOKALISASI BAHASA (OPSIONAL, BISA DIKOSONGKAN DEFAULT)
# ==========================================================================
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# ==========================================================================
# 4. MAINTENANCE MODE (JANGAN DIUBAH KALAU TIDAK PERLU)
# ==========================================================================
APP_MAINTENANCE_DRIVER=file

# ==========================================================================
# 🔴 5. DATABASE MYSQL CPANEL (WAJIB DIISI!)
# --------------------------------------------------------------------------
#   - JANGAN PAKAI SQLITE di SHARED HOSTING! (cepat rusak + kena limit inode)
#   - Buat dulu database + user di cPanel -> MySQL Databases
#   - Nama DB & username di cPanel SELALU diawali dengan USERNAME_CPANNEL_
#     Contoh: username cPanel = agusgero
#       -> nama DB  : agusgero_mebel
#       -> username : agusgero_userdb
# ==========================================================================
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=USERNAME_CPANNEL_mebel              # 👉 Ganti USERNAME_CPANNEL + nama DB yang kamu buat
DB_USERNAME=USERNAME_CPANNEL_userdb             # 👉 Ganti USERNAME_CPANNEL + username DB yang kamu buat
DB_PASSWORD=password_db_yang_kuat123            # 👉 Ganti dengan password DB (min 12 char campur)

# ==========================================================================
# 🔴 6. SESSION & CACHE (UNTUK STABILITAS DI SHARED HOSTING)
# --------------------------------------------------------------------------
#   - Session pakai DATABASE: agar tidak kena limit file session di /tmp
#   - Cache  pakai DATABASE: agar tidak kena limit file cache
#   - Queue  pakai SYNC: agar tidak perlu jalani queue worker (hemat resource)
# ==========================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null                              # 👉 jika pakai subdomain, isi: .namadomainkamu.com

FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync                            # 👉 DI SHARED HOSTING BIARKAN sync (tidak perlu queue:work)
CACHE_STORE=database
CACHE_PREFIX=agusmebel_

# ==========================================================================
# 7. EMAIL / MAIL (OPSIONAL, BIARKAN LOG JIKA TIDAK PAKAI EMAIL)
# --------------------------------------------------------------------------
#   - Jika mau pakai email dari cPanel (contoh: info@namadomain.com):
#       MAIL_MAILER=smtp
#       MAIL_HOST=mail.namadomainkamu.com
#       MAIL_PORT=465
#       MAIL_USERNAME=info@namadomainkamu.com
#       MAIL_PASSWORD=password_emailnya
#       MAIL_ENCRYPTION=ssl
#       MAIL_FROM_ADDRESS=info@namadomainkamu.com
# ==========================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@namadomainkamu.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================================================
# 8. LOGGING (JANGAN DIUBAH KALAU TIDAK PERLU)
# ==========================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning                                 # 👉 production cukup warning saja (hemat storage log)

# ==========================================================================
# 9. BCrypt Hashing (JANGAN DIUBAH)
# ==========================================================================
BCRYPT_ROUNDS=12

# ==========================================================================
# 10. VITE / ASSET (TIDAK PERLU DIUBAH — asset sudah di-build sebelum upload)
# ==========================================================================
VITE_APP_NAME="${APP_NAME}"

# ==========================================================================
# 11. AWS S3 (TIDAK PERLU DIISI KALAU TIDAK PAKAI S3)
# ==========================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==========================================================================
# 12. REDIS / MEMCACHED (TIDAK PERLU DIISI KALAU TIDAK PAKAI)
# ==========================================================================
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==========================================================================
# BROADCASTING (TIDAK PERLU DIUBAH)
# ==========================================================================
BROADCAST_CONNECTION=log
